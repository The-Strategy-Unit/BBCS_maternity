# Share only the files needed to reproduce the ONS report.
# Generated output, private Sankey data, local files and old report copies stay local.
*
!/data/
!/R/
# Include current and future R scripts, including scripts in subfolders.
!/R/**/
!/R/**/*.R
!/R/**/*.r
!/assets/
!/config/
!/.gitignore
!/CODEOWNERS
!/LICENSE
!/README.md
!/ONS-analysis-notes.md
!/terminology-key.md
!/index.qmd
!/_quarto.yml
!/_brand.yml
!/styles.css
!/config/analysis_parameters.csv
!/config/local_authorities.csv
!/assets/logo_black_favicon.png
!/assets/logo_black_medium.png
!/assets/logo_yellow_medium.png
!/data/2023birthregistrations.xlsx
!/data/2024birthregistrations.xlsx
!/data/2025birthregistrations.xlsx
!/data/ons_2022_based_births_migration_category.csv
!/data/2022 SNPP Births persons.csv
!/data/ons_2022_based_female_population_projections.csv
!/data/ons_2022_based_female_population_projections_2023_geography.csv
!/data/ons_live_births_la_2013_2025.csv
!/ONS Birth Methods Review.docx

# Generated Quarto files and separately supplied data stay local.
/.quarto/
**/*.quarto_ipynb
/_site/
/_freeze/
/*_files/
/*_cache/
/sankey data/
/.patient_flows.rds
